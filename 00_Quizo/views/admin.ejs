<%- include("partials/header") %>

<!-- Page Header (Large, Left-Aligned) -->
<div class="panel-header">
    <h1 class="panel-title">Administrator Management Panel</h1>
    <p class="panel-subtitle">
        System metrics, assessment question bank management, user rankings, and batch data imports.
    </p>
</div>

<!-- Admin Stats Grid -->
<div class="stats-grid mb-4">
    <div class="stat-box">
        <div class="stat-box-label">Total Users</div>
        <div class="stat-box-value"><%= totalUsers %></div>
        <div class="stat-box-desc">Registered student accounts</div>
    </div>

    <div class="stat-box">
        <div class="stat-box-label">Total Questions</div>
        <div class="stat-box-value"><%= totalQuestions %></div>
        <div class="stat-box-desc">Active question bank items</div>
    </div>

    <div class="stat-box">
        <div class="stat-box-label">Quiz Attempts</div>
        <div class="stat-box-value"><%= totalAttempts %></div>
        <div class="stat-box-desc">Lifetime submissions</div>
    </div>

    <div class="stat-box">
        <div class="stat-box-label">Avg Accuracy</div>
        <div class="stat-box-value text-success"><%= averageAccuracy %>%</div>
        <div class="stat-box-desc">Across all attempts</div>
    </div>

    <div class="stat-box">
        <div class="stat-box-label">Top Subject</div>
        <div class="stat-box-value"><%= mostPopularSubject %></div>
        <div class="stat-box-desc">Highest participation rate</div>
    </div>
</div>

<!-- Vertically Stacked Section 1: Top Users Table -->
<h2 class="section-title">Leading Learners</h2>
<p class="section-subtitle">Top learners with highest earned XP and quiz completions.</p>

<div class="table-responsive mb-4">
    <table class="table">
        <thead>
            <tr>
                <th style="width: 80px;">Rank</th>
                <th>Learner Name</th>
                <th>Total XP</th>
                <th>Quizzes Taken</th>
            </tr>
        </thead>
        <tbody>
            <% topUsers.forEach((user, index) => { %>
                <tr>
                    <td><strong>#<%= index + 1 %></strong></td>
                    <td><%= user.name %></td>
                    <td><span class="text-success fw-semibold"><%= user.xp %> XP</span></td>
                    <td><%= user.totalQuizzes %></td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>

<hr class="section-divider">

<!-- Vertically Stacked Section 2: Question Management Forms -->
<div class="row g-4 mb-4">
    <!-- Add Single Question -->
    <div class="col-lg-8">
        <div class="stat-box">
            <h3 class="h6 fw-bold text-dark mb-3">
                <i class="bi bi-plus-square-fill me-1 text-primary"></i> Add New Assessment Question
            </h3>

            <form action="/admin/add" method="POST">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Subject</label>
                        <input class="form-control" name="subject" placeholder="e.g. Java, Python, DBMS" required>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Topic</label>
                        <input class="form-control" name="topic" placeholder="e.g. OOP, Normalization" required>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Difficulty Level</label>
                        <select class="form-select" name="difficulty" required>
                            <option value="easy">Easy</option>
                            <option value="medium">Medium</option>
                            <option value="hard">Hard</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Question Text</label>
                        <textarea class="form-control" name="question" rows="3" placeholder="Enter the complete question prompt..." required></textarea>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Option 1</label>
                        <input class="form-control" name="opt1" placeholder="First option" required>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Option 2</label>
                        <input class="form-control" name="opt2" placeholder="Second option" required>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Option 3</label>
                        <input class="form-control" name="opt3" placeholder="Third option" required>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Option 4</label>
                        <input class="form-control" name="opt4" placeholder="Fourth option" required>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Correct Answer</label>
                        <input class="form-control" name="correctAnswer" placeholder="Exact match with one of the options above" required>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Explanation</label>
                        <textarea class="form-control" name="explanation" rows="2" placeholder="Detailed educational explanation..." required></textarea>
                    </div>

                    <div class="col-12">
                        <button type="submit" class="btn btn-quizo-primary">
                            <i class="fa-solid fa-plus me-1"></i> Add Question to Bank
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Batch Import via Excel / CSV -->
    <div class="col-lg-4">
        <div class="stat-box h-100">
            <h3 class="h6 fw-bold text-dark mb-3">
                <i class="bi bi-file-earmark-excel-fill me-1 text-primary"></i> Batch Import Questions
            </h3>
            <p class="text-muted small mb-3">
                Upload an Excel spreadsheet (.xlsx) or CSV file with columns: <code>subject</code>, <code>topic</code>, <code>difficulty</code>, <code>question</code>, <code>options</code>, <code>correctAnswer</code>, <code>explanation</code>.
            </p>

            <form action="/admin/import" method="POST" enctype="multipart/form-data">
                <div class="mb-3">
                    <label class="form-label">Select Spreadsheet File</label>
                    <input type="file" class="form-control" name="excelFile" accept=".xlsx,.csv" required>
                </div>

                <button type="submit" class="btn btn-quizo-secondary w-100">
                    <i class="fa-solid fa-upload me-1"></i> Import Questions File
                </button>
            </form>
        </div>
    </div>
</div>

<hr class="section-divider">

<!-- Vertically Stacked Section 3: Question Filter & Management Table -->
<h2 class="section-title">Question Bank Repository</h2>
<p class="section-subtitle">Filter, view, edit, or delete existing questions in the assessment database.</p>

<!-- Filter Form -->
<form action="/admin" method="GET" class="row g-2 align-items-end mb-3">
    <div class="col-md-5">
        <label class="form-label">Filter by Subject</label>
        <select name="subject" class="form-select">
            <option value="">All Subjects</option>
            <% subjects.forEach(s => { %>
                <option value="<%= s %>" <%= subject === s ? "selected" : "" %>>
                    <%= s %>
                </option>
            <% }) %>
        </select>
    </div>

    <div class="col-md-4">
        <label class="form-label">Filter by Difficulty</label>
        <select name="difficulty" class="form-select">
            <option value="">All Difficulties</option>
            <option value="easy" <%= difficulty === "easy" ? "selected" : "" %>>Easy</option>
            <option value="medium" <%= difficulty === "medium" ? "selected" : "" %>>Medium</option>
            <option value="hard" <%= difficulty === "hard" ? "selected" : "" %>>Hard</option>
        </select>
    </div>

    <div class="col-md-3">
        <button type="submit" class="btn btn-quizo-primary w-100">
            <i class="fa-solid fa-filter me-1"></i> Apply Filters
        </button>
    </div>
</form>

<!-- Questions Table -->
<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th style="width: 140px;">Subject</th>
                <th style="width: 110px;">Difficulty</th>
                <th>Question Prompt</th>
                <th style="width: 130px; text-align: center;">Actions</th>
            </tr>
        </thead>
        <tbody>
            <% if (questions && questions.length > 0) { %>
                <% questions.forEach(q => { %>
                    <tr>
                        <td><strong><%= q.subject %></strong></td>
                        <td>
                            <span class="badge bg-secondary"><%= q.difficulty %></span>
                        </td>
                        <td><%= q.question %></td>
                        <td style="text-align: center;">
                            <div class="d-inline-flex gap-1">
                                <a href="/admin/edit/<%= q._id %>" class="btn btn-warning btn-sm" title="Edit Question">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a href="/admin/delete/<%= q._id %>" class="btn btn-danger btn-sm" data-confirm="true"
                                    data-confirm-title="Delete Question?"
                                    data-confirm-text="This question will be permanently removed from the database."
                                    data-confirm-icon="warning" title="Delete Question">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="4" class="text-center text-muted py-4">
                        No questions found matching your filter criteria.
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>

<%- include("partials/footer") %>

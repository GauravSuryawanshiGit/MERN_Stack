<%- include("partials/header") %>

<div class="container-fluid">

    <!-- Page Header -->

    <div class="card hero-card border-0 shadow-lg mb-4">

        <div class="card-body p-4">

            <h1 class="fw-bold">
                ✏️ Edit Question
            </h1>

            <p class="mb-0">
                Update question details and save your changes.
            </p>

        </div>

    </div>

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <form action="/admin/edit/<%= question._id %>" method="POST">

                        <!-- Subject -->

                        <label class="form-label fw-semibold">
                            Subject
                        </label>

                        <input
                            type="text"
                            name="subject"
                            class="form-control mb-3"
                            value="<%= question.subject %>"
                            required
                        >

                        <!-- Topic -->

                        <label class="form-label fw-semibold">
                            Topic
                        </label>

                        <input
                            type="text"
                            name="topic"
                            class="form-control mb-3"
                            value="<%= question.topic %>"
                            required
                        >

                        <!-- Difficulty -->

                        <label class="form-label fw-semibold">
                            Difficulty
                        </label>

                        <select
                            name="difficulty"
                            class="form-select mb-3"
                        >

                            <option
                                value="easy"
                                <%= question.difficulty==="easy" ? "selected" : "" %>>
                                Easy
                            </option>

                            <option
                                value="medium"
                                <%= question.difficulty==="medium" ? "selected" : "" %>>
                                Medium
                            </option>

                            <option
                                value="hard"
                                <%= question.difficulty==="hard" ? "selected" : "" %>>
                                Hard
                            </option>

                        </select>

                        <!-- Question -->

                        <label class="form-label fw-semibold">
                            Question
                        </label>

                        <textarea
                            name="question"
                            class="form-control mb-3"
                            rows="4"
                            required
                        ><%= question.question %></textarea>

                        <!-- Options -->

                        <label class="form-label fw-semibold">
                            Option 1
                        </label>

                        <input
                            class="form-control mb-3"
                            name="opt1"
                            value="<%= question.options[0] %>"
                            required
                        >

                        <label class="form-label fw-semibold">
                            Option 2
                        </label>

                        <input
                            class="form-control mb-3"
                            name="opt2"
                            value="<%= question.options[1] %>"
                            required
                        >

                        <label class="form-label fw-semibold">
                            Option 3
                        </label>

                        <input
                            class="form-control mb-3"
                            name="opt3"
                            value="<%= question.options[2] %>"
                            required
                        >

                        <label class="form-label fw-semibold">
                            Option 4
                        </label>

                        <input
                            class="form-control mb-3"
                            name="opt4"
                            value="<%= question.options[3] %>"
                            required
                        >

                        <!-- Correct Answer -->

                        <label class="form-label fw-semibold">
                            Correct Answer
                        </label>

                        <input
                            class="form-control mb-3"
                            name="correctAnswer"
                            value="<%= question.correctAnswer %>"
                            required
                        >

                        <!-- Explanation -->

                        <label class="form-label fw-semibold">
                            Explanation
                        </label>

                        <textarea
                            name="explanation"
                            class="form-control mb-4"
                            rows="4"
                            required
                        ><%= question.explanation %></textarea>

                        <!-- Buttons -->

                        <div class="d-flex justify-content-between">

                            <a
                                href="/admin"
                                class="btn btn-secondary"
                            >
                                ← Cancel
                            </a>

                            <button
                                class="btn btn-success px-5"
                            >
                                💾 Update Question
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

<%- include("partials/footer") %>
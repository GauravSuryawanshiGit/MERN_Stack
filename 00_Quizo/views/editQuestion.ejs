<%- include("partials/header") %>

<!-- Page Header (Large, Left-Aligned) -->
<div class="panel-header">
    <h1 class="panel-title">Edit Assessment Question</h1>
    <p class="panel-subtitle">
        Update question details, options, difficulty level, or explanations in the assessment repository.
    </p>
</div>

<div class="auth-panel-wrapper" style="max-width: 720px;">
    <form action="/admin/edit/<%= question._id %>" method="POST">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Subject</label>
                <input type="text" name="subject" class="form-control" value="<%= question.subject %>" required>
            </div>

            <div class="col-md-6">
                <label class="form-label">Topic</label>
                <input type="text" name="topic" class="form-control" value="<%= question.topic %>" required>
            </div>

            <div class="col-12">
                <label class="form-label">Difficulty Level</label>
                <select name="difficulty" class="form-select" required>
                    <option value="easy" <%= question.difficulty === "easy" ? "selected" : "" %>>Easy</option>
                    <option value="medium" <%= question.difficulty === "medium" ? "selected" : "" %>>Medium</option>
                    <option value="hard" <%= question.difficulty === "hard" ? "selected" : "" %>>Hard</option>
                </select>
            </div>

            <div class="col-12">
                <label class="form-label">Question Text</label>
                <textarea name="question" class="form-control" rows="3" required><%= question.question %></textarea>
            </div>

            <div class="col-md-6">
                <label class="form-label">Option 1</label>
                <input class="form-control" name="opt1" value="<%= question.options && question.options[0] ? question.options[0] : '' %>" required>
            </div>

            <div class="col-md-6">
                <label class="form-label">Option 2</label>
                <input class="form-control" name="opt2" value="<%= question.options && question.options[1] ? question.options[1] : '' %>" required>
            </div>

            <div class="col-md-6">
                <label class="form-label">Option 3</label>
                <input class="form-control" name="opt3" value="<%= question.options && question.options[2] ? question.options[2] : '' %>" required>
            </div>

            <div class="col-md-6">
                <label class="form-label">Option 4</label>
                <input class="form-control" name="opt4" value="<%= question.options && question.options[3] ? question.options[3] : '' %>" required>
            </div>

            <div class="col-12">
                <label class="form-label">Correct Answer</label>
                <input class="form-control" name="correctAnswer" value="<%= question.correctAnswer %>" required>
            </div>

            <div class="col-12">
                <label class="form-label">Explanation</label>
                <textarea class="form-control" name="explanation" rows="3" required><%= question.explanation %></textarea>
            </div>

            <div class="col-12 d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-quizo-primary">
                    <i class="fa-solid fa-floppy-disk me-1"></i> Save Changes
                </button>
                <a href="/admin" class="btn btn-quizo-secondary">
                    Cancel
                </a>
            </div>
        </div>
    </form>
</div>

<%- include("partials/footer") %>

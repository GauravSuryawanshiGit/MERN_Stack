<%- include("../partials/header") %>

<!-- Page Header (Large, Left-Aligned) -->
<div class="panel-header">
    <h1 class="panel-title">Global Leaderboard</h1>
    <p class="panel-subtitle">
        National rankings for learners on Quizo based on total accumulated experience points (XP), assessment accuracy, and active streaks.
    </p>
</div>

<!-- Section 1: Top 3 Performers (Clean Podium Cards) -->
<div class="row g-3 mb-4">
    <!-- Rank 1 (Gold) -->
    <% if (leaders && leaders[0]) { %>
        <% const acc0 = leaders[0].totalQuestions > 0 ? Math.round((leaders[0].totalCorrect / leaders[0].totalQuestions) * 100) : 0; %>
        <div class="col-lg-4 col-md-12">
            <div class="stat-box h-100 border-2" style="border-color: #F59E0B !important;">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="badge bg-warning text-dark"><i class="fa-solid fa-crown me-1"></i> Rank 1 (Champion)</span>
                    <span class="text-warning fs-5"><i class="fa-solid fa-medal"></i></span>
                </div>
                <h3 class="h5 fw-bold text-dark mb-1"><%= leaders[0].name %></h3>
                <div class="d-flex gap-4 mt-2">
                    <div>
                        <div class="stat-box-label">Total XP</div>
                        <div class="fw-bold fs-5 text-success"><%= leaders[0].xp %> XP</div>
                    </div>
                    <div>
                        <div class="stat-box-label">Accuracy</div>
                        <div class="fw-bold fs-5"><%= acc0 %>%</div>
                    </div>
                    <div>
                        <div class="stat-box-label">Streak</div>
                        <div class="fw-bold fs-5 text-warning"><i class="fa-solid fa-fire me-1"></i><%= leaders[0].streak || 0 %></div>
                    </div>
                </div>
            </div>
        </div>
    <% } %>

    <!-- Rank 2 (Silver) -->
    <% if (leaders && leaders[1]) { %>
        <% const acc1 = leaders[1].totalQuestions > 0 ? Math.round((leaders[1].totalCorrect / leaders[1].totalQuestions) * 100) : 0; %>
        <div class="col-lg-4 col-md-6">
            <div class="stat-box h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="badge bg-secondary"><i class="fa-solid fa-medal me-1"></i> Rank 2 (Runner Up)</span>
                    <span class="text-secondary fs-5"><i class="fa-solid fa-medal"></i></span>
                </div>
                <h3 class="h5 fw-bold text-dark mb-1"><%= leaders[1].name %></h3>
                <div class="d-flex gap-4 mt-2">
                    <div>
                        <div class="stat-box-label">Total XP</div>
                        <div class="fw-bold fs-5 text-success"><%= leaders[1].xp %> XP</div>
                    </div>
                    <div>
                        <div class="stat-box-label">Accuracy</div>
                        <div class="fw-bold fs-5"><%= acc1 %>%</div>
                    </div>
                    <div>
                        <div class="stat-box-label">Streak</div>
                        <div class="fw-bold fs-5 text-warning"><i class="fa-solid fa-fire me-1"></i><%= leaders[1].streak || 0 %></div>
                    </div>
                </div>
            </div>
        </div>
    <% } %>

    <!-- Rank 3 (Bronze) -->
    <% if (leaders && leaders[2]) { %>
        <% const acc2 = leaders[2].totalQuestions > 0 ? Math.round((leaders[2].totalCorrect / leaders[2].totalQuestions) * 100) : 0; %>
        <div class="col-lg-4 col-md-6">
            <div class="stat-box h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="badge bg-danger"><i class="fa-solid fa-medal me-1"></i> Rank 3</span>
                    <span class="text-danger fs-5"><i class="fa-solid fa-medal"></i></span>
                </div>
                <h3 class="h5 fw-bold text-dark mb-1"><%= leaders[2].name %></h3>
                <div class="d-flex gap-4 mt-2">
                    <div>
                        <div class="stat-box-label">Total XP</div>
                        <div class="fw-bold fs-5 text-success"><%= leaders[2].xp %> XP</div>
                    </div>
                    <div>
                        <div class="stat-box-label">Accuracy</div>
                        <div class="fw-bold fs-5"><%= acc2 %>%</div>
                    </div>
                    <div>
                        <div class="stat-box-label">Streak</div>
                        <div class="fw-bold fs-5 text-warning"><i class="fa-solid fa-fire me-1"></i><%= leaders[2].streak || 0 %></div>
                    </div>
                </div>
            </div>
        </div>
    <% } %>
</div>

<!-- Section 2: Complete Rankings Table -->
<h2 class="section-title">All Rankings</h2>
<p class="section-subtitle">Full list of participants ordered by total accumulated XP.</p>

<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th style="width: 80px;">Rank</th>
                <th>Learner</th>
                <th>Experience Points</th>
                <th>Accuracy</th>
                <th>Streak</th>
                <th>Quizzes Taken</th>
            </tr>
        </thead>
        <tbody>
            <% if (leaders && leaders.length > 0) { %>
                <% leaders.forEach((user, index) => { %>
                    <% const accuracy = user.totalQuestions > 0 ? Math.round((user.totalCorrect / user.totalQuestions) * 100) : 0; %>
                    <tr>
                        <td>
                            <% if (index === 0) { %>
                                <span class="badge bg-warning text-dark">#1</span>
                            <% } else if (index === 1) { %>
                                <span class="badge bg-secondary">#2</span>
                            <% } else if (index === 2) { %>
                                <span class="badge bg-danger">#3</span>
                            <% } else { %>
                                <span class="fw-semibold text-muted">#<%= index + 1 %></span>
                            <% } %>
                        </td>
                        <td>
                            <strong><%= user.name %></strong>
                        </td>
                        <td>
                            <span class="text-success fw-semibold"><%= user.xp || 0 %> XP</span>
                        </td>
                        <td>
                            <%= accuracy %>%
                        </td>
                        <td>
                            <i class="fa-solid fa-fire text-warning me-1"></i><%= user.streak || 0 %> Days
                        </td>
                        <td>
                            <%= user.totalQuizzes || 0 %>
                        </td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">
                        No leaderboard rankings available yet.
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>

<%- include("../partials/footer") %>

<%- include("partials/header") %>

<!-- Header Section (Large, Left-Aligned Heading & Subtitle) -->
<div class="panel-header">
    <h1 class="panel-title">
        <% if (user) { %>
            Welcome Back, <%= user.name %>
        <% } else { %>
            Welcome to Quizo
        <% } %>
    </h1>
    <p class="panel-subtitle">
        Enterprise-grade skill assessment platform featuring over 3,000+ curated questions across Programming, Placement Exams, and General Knowledge. Practice with zero-repetition logic.
    </p>
</div>

<!-- Primary & Secondary Action Buttons (Rectangular, Left-Aligned) -->
<div class="d-flex flex-wrap gap-2 mb-4">
    <% if (user) { %>
        <a href="#customBuilder" class="btn btn-quizo-primary">
            <i class="fa-solid fa-play me-1"></i> Start Custom Quiz
        </a>
        <a href="/dashboard" class="btn btn-quizo-secondary">
            <i class="fa-solid fa-gauge-high me-1"></i> View Dashboard
        </a>
        <a href="/leaderboard" class="btn btn-outline-success">
            <i class="fa-solid fa-trophy me-1"></i> Leaderboard
        </a>
    <% } else { %>
        <a href="/signup" class="btn btn-quizo-primary">
            <i class="fa-solid fa-user-plus me-1"></i> Create Free Account
        </a>
        <a href="/login" class="btn btn-quizo-secondary">
            <i class="fa-solid fa-right-to-bracket me-1"></i> Login
        </a>
        <a href="#quickStart" class="btn btn-outline-success">
            <i class="fa-solid fa-play me-1"></i> Browse Quizzes
        </a>
    <% } %>
</div>

<!-- Vertically Stacked Section 1: Overview Summary / Key Metrics -->
<% if (user) { %>
    <div class="stats-grid mb-4">
        <div class="stat-box">
            <div class="stat-box-label">Experience Points</div>
            <div class="stat-box-value"><%= user.xp || 0 %> XP</div>
            <div class="stat-box-desc">Total earned across all quizzes</div>
        </div>
        <div class="stat-box">
            <div class="stat-box-label">Current Level</div>
            <div class="stat-box-value">
                Level <%= (user.xp || 0) >= 2500 ? 7 : (user.xp || 0) >= 1500 ? 6 : (user.xp || 0) >= 1000 ? 5 : (user.xp || 0) >= 600 ? 4 : (user.xp || 0) >= 300 ? 3 : (user.xp || 0) >= 100 ? 2 : 1 %>
            </div>
            <div class="stat-box-desc">Keep answering to level up</div>
        </div>
        <div class="stat-box">
            <div class="stat-box-label">Completed Quizzes</div>
            <div class="stat-box-value"><%= user.totalQuizzes || 0 %></div>
            <div class="stat-box-desc">Total assessments finished</div>
        </div>
        <div class="stat-box">
            <div class="stat-box-label">Active Streak</div>
            <div class="stat-box-value">
                <i class="fa-solid fa-fire text-warning me-1"></i><%= user.streak || 0 %> Days
            </div>
            <div class="stat-box-desc">Consecutive days of practice</div>
        </div>
    </div>
<% } else { %>
    <div class="stats-grid mb-4">
        <div class="stat-box">
            <div class="stat-box-label">Curated Question Bank</div>
            <div class="stat-box-value">3,250+</div>
            <div class="stat-box-desc">Verified unique assessment items</div>
        </div>
        <div class="stat-box">
            <div class="stat-box-label">Domains & Subjects</div>
            <div class="stat-box-value">33 Categories</div>
            <div class="stat-box-desc">Programming, Placements, General Knowledge</div>
        </div>
        <div class="stat-box">
            <div class="stat-box-label">Question History</div>
            <div class="stat-box-value text-success">Zero Repetition</div>
            <div class="stat-box-desc">Persistent question tracking per user</div>
        </div>
        <div class="stat-box">
            <div class="stat-box-label">AI Study Assistant</div>
            <div class="stat-box-value">24/7 Active</div>
            <div class="stat-box-desc">Ask questions anytime via chat</div>
        </div>
    </div>
<% } %>

<hr class="section-divider">

<!-- Vertically Stacked Section 2: Quick Start Quizzes -->
<div id="quickStart">
    <h2 class="section-title">Quick Start Quizzes</h2>
    <p class="section-subtitle">
        Jump straight into practice across core computer science and competitive topics.
    </p>

    <div class="subject-grid">
        <!-- Java -->
        <div class="subject-item-card">
            <div>
                <div class="subject-item-header">
                    <h3 class="subject-item-title">Java</h3>
                    <span class="subject-item-badge">Programming</span>
                </div>
                <p class="subject-item-desc">
                    Core Java, OOPs concepts, exceptions, JVM architecture, and collections.
                </p>
            </div>
            <a href="/quiz/start?category=Java&difficulty=easy&count=10" class="btn btn-quizo-primary w-100">
                Start Java Quiz
            </a>
        </div>

        <!-- Python -->
        <div class="subject-item-card">
            <div>
                <div class="subject-item-header">
                    <h3 class="subject-item-title">Python</h3>
                    <span class="subject-item-badge">Programming</span>
                </div>
                <p class="subject-item-desc">
                    Syntax, data types, control flow, functions, modules, and data handling.
                </p>
            </div>
            <a href="/quiz/start?category=Python&difficulty=easy&count=10" class="btn btn-quizo-primary w-100">
                Start Python Quiz
            </a>
        </div>

        <!-- DSA -->
        <div class="subject-item-card">
            <div>
                <div class="subject-item-header">
                    <h3 class="subject-item-title">DSA</h3>
                    <span class="subject-item-badge">Algorithms</span>
                </div>
                <p class="subject-item-desc">
                    Arrays, linked lists, stacks, queues, trees, searching, and sorting.
                </p>
            </div>
            <a href="/quiz/start?category=DSA&difficulty=easy&count=10" class="btn btn-quizo-primary w-100">
                Start DSA Quiz
            </a>
        </div>

        <!-- DBMS -->
        <div class="subject-item-card">
            <div>
                <div class="subject-item-header">
                    <h3 class="subject-item-title">DBMS & SQL</h3>
                    <span class="subject-item-badge">Databases</span>
                </div>
                <p class="subject-item-desc">
                    SQL queries, normalization, ACID properties, transactions, and indexing.
                </p>
            </div>
            <a href="/quiz/start?category=DBMS&difficulty=easy&count=10" class="btn btn-quizo-primary w-100">
                Start DBMS Quiz
            </a>
        </div>

        <!-- Aptitude -->
        <div class="subject-item-card">
            <div>
                <div class="subject-item-header">
                    <h3 class="subject-item-title">Quantitative Aptitude</h3>
                    <span class="subject-item-badge">Placements</span>
                </div>
                <p class="subject-item-desc">
                    Percentages, profit & loss, time and work, ratios, and averages.
                </p>
            </div>
            <a href="/quiz/start?category=Aptitude&difficulty=easy&count=10" class="btn btn-quizo-primary w-100">
                Start Aptitude Quiz
            </a>
        </div>

        <!-- Indian History -->
        <div class="subject-item-card">
            <div>
                <div class="subject-item-header">
                    <h3 class="subject-item-title">Indian History</h3>
                    <span class="subject-item-badge">General Knowledge</span>
                </div>
                <p class="subject-item-desc">
                    Ancient civilizations, medieval empires, and freedom movement milestones.
                </p>
            </div>
            <a href="/quiz/start?category=Indian%20History&difficulty=easy&count=10" class="btn btn-quizo-primary w-100">
                Start History Quiz
            </a>
        </div>
    </div>
</div>

<hr class="section-divider">

<!-- Vertically Stacked Section 3: Advanced Custom Quiz Builder -->
<div class="builder-box" id="customBuilder">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
        <h2 class="section-title mt-0 mb-0">Custom Quiz Builder</h2>
        <span id="unseenBadge" class="badge bg-success px-3 py-2 fs-6">Checking availability...</span>
    </div>
    <p class="section-subtitle">
        Configure your quiz parameters across domains, categories, and difficulty levels. Quizo automatically excludes all questions you have previously seen.
    </p>

    <form action="/quiz/start" method="GET" id="customQuizForm">
        <div class="row g-3 align-items-end">
            <!-- Domain Selection -->
            <div class="col-lg-3 col-md-6">
                <label for="domainSelect" class="form-label">Domain</label>
                <select class="form-select" id="domainSelect" name="domain">
                    <option value="Programming & CS">Programming & CS</option>
                    <option value="Placements & Exams">Competitive Exams & Placements</option>
                    <option value="General Knowledge">General Knowledge & Learning</option>
                </select>
            </div>

            <!-- Category / Subject Selection -->
            <div class="col-lg-3 col-md-6">
                <label for="categorySelect" class="form-label">Category</label>
                <select class="form-select" id="categorySelect" name="category" required>
                    <!-- Populated dynamically via JS -->
                </select>
            </div>

            <!-- Difficulty Selection -->
            <div class="col-lg-2 col-md-6">
                <label for="difficultySelect" class="form-label">Difficulty</label>
                <select class="form-select" id="difficultySelect" name="difficulty" required>
                    <option value="easy">Easy</option>
                    <option value="medium">Medium</option>
                    <option value="hard">Hard</option>
                </select>
            </div>

            <!-- Number of Questions -->
            <div class="col-lg-2 col-md-6">
                <label for="countSelect" class="form-label">Question Count</label>
                <select class="form-select" id="countSelect" name="count" required>
                    <option value="5">5 Questions</option>
                    <option value="10" selected>10 Questions</option>
                    <option value="15">15 Questions</option>
                    <option value="20">20 Questions</option>
                    <option value="30">30 Questions</option>
                </select>
            </div>

            <!-- Submit Button -->
            <div class="col-lg-2 col-md-6">
                <button type="submit" class="btn btn-quizo-primary w-100" id="startQuizBtn">
                    <i class="fa-solid fa-play me-1"></i> Start Quiz
                </button>
            </div>
        </div>
    </form>
</div>

<%- include("partials/footer") %>

<!-- Dynamic Cascading Domain & Unseen Count Script -->
<script>
    const DOMAIN_CATEGORIES = {
        "Programming & CS": [
            { id: "Java", name: "Java" },
            { id: "Python", name: "Python" },
            { id: "JavaScript", name: "JavaScript" },
            { id: "C", name: "C Programming" },
            { id: "C++", name: "C++" },
            { id: "DSA", name: "Data Structures & Algorithms" },
            { id: "DBMS", name: "DBMS & SQL" },
            { id: "OS", name: "Operating Systems" },
            { id: "CN", name: "Computer Networks" },
            { id: "Software Engineering", name: "Software Engineering" },
            { id: "Web Development", name: "Web Development" },
            { id: "Cybersecurity", name: "Cybersecurity" },
            { id: "Cloud Computing", name: "Cloud Computing" },
            { id: "AI & ML", name: "AI & Machine Learning" },
            { id: "Generative AI", name: "Generative AI & RAG" }
        ],
        "Placements & Exams": [
            { id: "Aptitude", name: "Quantitative Aptitude" },
            { id: "Logical Reasoning", name: "Logical Reasoning" },
            { id: "Verbal Ability", name: "Verbal Ability" },
            { id: "English Grammar", name: "English Grammar" },
            { id: "Coding MCQs", name: "Coding MCQs & Output" },
            { id: "General Computer Awareness", name: "Computer Awareness" }
        ],
        "General Knowledge": [
            { id: "Indian History", name: "Indian History" },
            { id: "Geography", name: "Geography" },
            { id: "General Science", name: "General Science" },
            { id: "General Knowledge", name: "General Knowledge" },
            { id: "Financial Literacy", name: "Financial Literacy" }
        ]
    };

    const domainSelect = document.getElementById("domainSelect");
    const categorySelect = document.getElementById("categorySelect");
    const difficultySelect = document.getElementById("difficultySelect");
    const unseenBadge = document.getElementById("unseenBadge");
    const startQuizBtn = document.getElementById("startQuizBtn");

    function updateCategoryDropdown() {
        const domain = domainSelect.value;
        const categories = DOMAIN_CATEGORIES[domain] || DOMAIN_CATEGORIES["Programming & CS"];

        categorySelect.innerHTML = "";
        categories.forEach(cat => {
            const opt = document.createElement("option");
            opt.value = cat.id;
            opt.textContent = cat.name;
            categorySelect.appendChild(opt);
        });

        checkUnseenCount();
    }

    async function checkUnseenCount() {
        const category = categorySelect.value;
        const difficulty = difficultySelect.value;
        const domain = domainSelect.value;

        if (!category) return;

        unseenBadge.textContent = "Checking availability...";
        unseenBadge.className = "badge bg-secondary px-3 py-2 fs-6";

        try {
            const res = await fetch(`/quiz/api/unseen-count?domain=${encodeURIComponent(domain)}&category=${encodeURIComponent(category)}&difficulty=${encodeURIComponent(difficulty)}`);
            const data = await res.json();
            const count = data.unseenCount || 0;

            if (count === 0) {
                unseenBadge.textContent = "All 100% Completed! (Exhausted)";
                unseenBadge.className = "badge bg-danger px-3 py-2 fs-6";
                startQuizBtn.innerHTML = '<i class="fa-solid fa-arrows-rotate me-1"></i> Reset / Practice';
            } else {
                unseenBadge.textContent = `${count} Unseen Questions Available`;
                unseenBadge.className = "badge bg-success px-3 py-2 fs-6";
                startQuizBtn.innerHTML = '<i class="fa-solid fa-play me-1"></i> Start Quiz';
            }
        } catch (err) {
            unseenBadge.textContent = "Ready to Practice";
            unseenBadge.className = "badge bg-success px-3 py-2 fs-6";
        }
    }

    domainSelect.addEventListener("change", updateCategoryDropdown);
    categorySelect.addEventListener("change", checkUnseenCount);
    difficultySelect.addEventListener("change", checkUnseenCount);

    document.addEventListener("DOMContentLoaded", () => {
        updateCategoryDropdown();
    });
</script>

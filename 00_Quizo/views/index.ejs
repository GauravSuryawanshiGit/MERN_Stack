<%- include("partials/header") %>

    <div class="container-fluid">


        <div class="card border-0 shadow-lg mb-5 hero-card">

            <div class="card-body p-5">

                <div class="row align-items-center">



                    <div class="col-lg-7">

                        <span class="hero-badge">

                            <i class="fa-solid fa-sparkles me-2"></i>

                            AI Powered Learning

                        </span>

                        <h1 class="fw-bold mt-3">

                            Welcome Back,

                            <span class="hero-name">

                                <%= user ? user.name : "Learner" %>

                            </span>

                            👋

                        </h1>

                        <p class="text-muted fs-5 mt-3">

                            Master Java, Python, DBMS, DSA and more with Quizo.

                        </p>

                        <div class="mt-4">

                            <% if (user) { %>

                                <a href="/leaderboard" class="btn btn-success btn-lg me-3">

                                    <i class="fa-solid fa-trophy me-2"></i>

                                    Leaderboard

                                </a>

                                <a href="/dashboard" class="btn btn-outline-success btn-lg">

                                    <i class="fa-solid fa-chart-line me-2"></i>

                                    Dashboard

                                </a>

                                <% } else { %>

                                    <a href="/signup" class="btn btn-success btn-lg me-3">

                                        <i class="fa-solid fa-user-plus me-2"></i>

                                        Create Account

                                    </a>

                                    <a href="/login" class="btn btn-outline-success btn-lg">

                                        <i class="fa-solid fa-right-to-bracket me-2"></i>

                                        Login

                                    </a>

                                    <% } %>

                        </div>

                    </div>


                    <div class="col-lg-5 d-none d-lg-block">

                        <div class="hero-visual">

                            <div class="floating-card">

                                <small>XP</small>

                                <h2>
                                    <%= user ? user.xp : 0 %>
                                </h2>

                            </div>

                            <div class="floating-card">

                                <small>Quizzes</small>

                                <h2>
                                    <%= user ? user.totalQuizzes : 0 %>
                                </h2>

                            </div>

                            <div class="floating-card">

                                <small>Streak</small>

                                <h2>🔥 <%= user ? user.streak : 0 %>
                                </h2>

                            </div>

                            <div class="hero-circle">

                                <i class="fa-solid fa-graduation-cap"></i>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="row g-4 mb-5">

            <div class="col-xl-3 col-md-6">

                <div class="card stat-card border-0 shadow-sm h-100">

                    <div class="card-body d-flex align-items-center">

                        <div class="stat-icon me-3">

                            <i class="fa-solid fa-file-circle-question"></i>

                        </div>

                        <div>

                            <small class="text-muted d-block">
                                Total Questions
                            </small>

                            <h2 class="fw-bold mb-0">
                                517+
                            </h2>

                        </div>

                    </div>

                </div>

            </div>

            <div class="col-xl-3 col-md-6">

                <div class="card stat-card border-0 shadow-sm h-100">

                    <div class="card-body d-flex align-items-center">

                        <div class="stat-icon me-3">

                            <i class="fa-solid fa-book-open"></i>

                        </div>

                        <div>

                            <small class="text-muted d-block">
                                Subjects
                            </small>

                            <h2 class="fw-bold mb-0">
                                9
                            </h2>

                        </div>

                    </div>

                </div>

            </div>

            <div class="col-xl-3 col-md-6">

                <div class="card stat-card border-0 shadow-sm h-100">

                    <div class="card-body d-flex align-items-center">

                        <div class="stat-icon me-3">

                            <i class="fa-solid fa-ranking-star"></i>

                        </div>

                        <div>

                            <small class="text-muted d-block">
                                Leaderboard
                            </small>

                            <h2 class="fw-bold mb-0 text-success">
                                LIVE
                            </h2>

                        </div>

                    </div>

                </div>

            </div>

            <div class="col-xl-3 col-md-6">

                <div class="card stat-card border-0 shadow-sm h-100">

                    <div class="card-body d-flex align-items-center">

                        <div class="stat-icon me-3">

                            <i class="fa-solid fa-robot"></i>

                        </div>

                        <div>

                            <small class="text-muted d-block">
                                Quiz Engine
                            </small>

                            <h2 class="fw-bold mb-0">
                                AI Ready
                            </h2>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="row g-4 mb-5">

            <div class="col-xl-3 col-md-6">

                <div class="card dashboard-stat border-0">

                    <div class="card-body">

                        <div class="d-flex justify-content-between align-items-center">

                            <div>

                                <small class="text-muted">
                                    XP
                                </small>

                                <h2 class="fw-bold mb-1">
                                    380
                                </h2>

                                <span class="text-success small fw-semibold">
                                    +120 XP Today
                                </span>

                            </div>

                            <div class="dashboard-icon bg-success-subtle">



                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <div class="col-xl-3 col-md-6">

                <div class="card dashboard-stat border-0">

                    <div class="card-body">

                        <div class="d-flex justify-content-between align-items-center">

                            <div>

                                <small class="text-muted">
                                    Level
                                </small>

                                <h2 class="fw-bold mb-1">
                                    4
                                </h2>

                                <span class="text-muted small">
                                    Next: 120 XP
                                </span>

                            </div>

                            <div class="dashboard-icon level">



                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <div class="col-xl-3 col-md-6">

                <div class="card dashboard-stat border-0">

                    <div class="card-body">

                        <div class="d-flex justify-content-between align-items-center">

                            <div>

                                <small class="text-muted">
                                    Rank
                                </small>

                                <h2 class="fw-bold mb-1">
                                    #2
                                </h2>

                                <span class="text-muted small">
                                    Top 1%
                                </span>

                            </div>

                            <div class="dashboard-icon trophy">



                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <div class="col-xl-3 col-md-6">

                <div class="card dashboard-stat border-0">

                    <div class="card-body">

                        <div class="d-flex justify-content-between align-items-center">

                            <div>

                                <small class="text-muted">
                                    Streak
                                </small>

                                <h2 class="fw-bold mb-1">
                                    🔥 5
                                </h2>

                                <span class="text-muted small">
                                    Best: 12 Days
                                </span>

                            </div>

                            <div class="dashboard-icon fire">



                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <h3 class="fw-bold mb-4">

            Quick Start Quiz
        </h3>

        <div class="row g-4">


            <div class="col-lg-4">
                <div class="card quiz-card border-0 shadow">

                    <div class="card-body text-center">

                        <div class="subject-icon">
                            <i class="fa-brands fa-java"></i>
                        </div>

                        <h4>Java</h4>

                        <p class="text-muted">
                            Core Java & OOP
                        </p>

                        <a href="/quiz/start?subject=Java&difficulty=easy&count=10" class="btn btn-success w-100">

                            Start Quiz </a>

                    </div>

                </div>
            </div>


            <div class="col-lg-4">
                <div class="card quiz-card border-0 shadow">

                    <div class="card-body text-center">

                        <div class="subject-icon">
                            <i class="fa-brands fa-python"></i>
                        </div>

                        <h4>Python</h4>

                        <p class="text-muted">
                            Python Fundamentals
                        </p>

                        <a href="/quiz/start?subject=Python&difficulty=easy&count=10" class="btn btn-success w-100">

                            Start Quiz </a>

                    </div>

                </div>
            </div>


            <div class="col-lg-4">
                <div class="card quiz-card border-0 shadow">

                    <div class="card-body text-center">

                        <div class="subject-icon">
                            <i class="fa-solid fa-database"></i>
                        </div>

                        <h4>DBMS</h4>

                        <p class="text-muted">
                            SQL & Database Concepts
                        </p>

                        <a href="/quiz/start?subject=DBMS&difficulty=easy&count=10" class="btn btn-success w-100">

                            Start Quiz </a>

                    </div>

                </div>
            </div>



            <div class="col-lg-4">
                <div class="card quiz-card border-0 shadow">

                    <div class="card-body text-center">

                        <div class="subject-icon">
                            <i class="fa-solid fa-desktop"></i>
                        </div>

                        <h4>Operating System</h4>

                        <p class="text-muted">
                            Scheduling & Memory
                        </p>

                        <a href="/quiz/start?subject=OS&difficulty=easy&count=10" class="btn btn-success w-100">

                            Start Quiz </a>

                    </div>

                </div>
            </div>


            <div class="col-lg-4">
                <div class="card quiz-card border-0 shadow">

                    <div class="card-body text-center">

                        <div class="subject-icon">
                            <i class="fa-solid fa-globe"></i>
                        </div>

                        <h4>Computer Networks</h4>

                        <p class="text-muted">
                            OSI, TCP/IP & DNS
                        </p>

                        <a href="/quiz/start?subject=CN&difficulty=easy&count=10" class="btn btn-success w-100">

                            Start Quiz </a>

                    </div>

                </div>
            </div>


            <div class="col-lg-4">
                <div class="card quiz-card border-0 shadow">

                    <div class="card-body text-center">

                        <div class="subject-icon">
                            <i class="fa-solid fa-cubes"></i>
                        </div>

                        <h4>DSA</h4>

                        <p class="text-muted">
                            Data Structures & Algorithms
                        </p>

                        <a href="/quiz/start?subject=DSA&difficulty=easy&count=10" class="btn btn-success w-100">

                            Start Quiz </a>

                    </div>

                </div>
            </div>

        </div>

    </div>



    <div class="card shadow-lg border-0 rounded-4 p-4 mt-5">

        <div class="text-center mb-4">

            <h2 class="fw-bold">

                🎯 Custom Quiz Builder

            </h2>

            <p class="text-muted">

                Choose your own quiz settings.

            </p>

        </div>

        <form action="/quiz/start" method="GET">

            <div class="row g-3 align-items-end">

                <div class="col-lg-4">

                    <label class="form-label fw-semibold">

                        Subject

                    </label>

                    <select class="form-select" name="subject">

                        <option value="Java">Java</option>

                        <option value="Python">Python</option>

                        <option value="DSA">DSA</option>

                        <option value="DBMS">DBMS</option>

                        <option value="OS">Operating System</option>

                        <option value="CN">Computer Networks</option>

                        <option value="Web Development">Web Development</option>

                        <option value="AI & ML">AI & ML</option>

                        <option value="Aptitude">Aptitude</option>

                    </select>

                </div>

                <div class="col-lg-3">

                    <label class="form-label fw-semibold">

                        Difficulty

                    </label>

                    <select class="form-select" name="difficulty" required>

                        <option value="easy">

                            Easy

                        </option>

                        <option value="medium">

                            Medium

                        </option>

                        <option value="hard">

                            Hard

                        </option>

                    </select>

                </div>

                <div class="col-lg-3">

                    <label class="form-label fw-semibold">

                        Number of Questions

                    </label>

                    <select class="form-select" name="count" required>

                        <option value="10">10</option>

                        <option value="20">20</option>

                        <option value="30">30</option>

                        <option value="40">40</option>

                        <option value="50">50</option>

                        <option value="100">100</option>

                    </select>

                </div>

                <div class="col-lg-2 d-grid">

                    <button class="btn btn-success">

                        Start Quiz

                    </button>

                </div>

            </div>

        </form>

    </div>



    <%- include("partials/footer") %>
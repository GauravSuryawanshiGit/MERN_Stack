<%- include("../partials/header") %>

<div class="auth-panel-wrapper">
    <!-- Page Header (Large, Left-Aligned) -->
    <div class="panel-header">
        <h1 class="panel-title">Email Already Registered</h1>
        <p class="panel-subtitle">
            An existing Quizo account is already associated with this email address.
        </p>
    </div>

    <div class="stat-box mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="text-warning fs-2">
                <i class="fa-solid fa-circle-exclamation"></i>
            </div>
            <div>
                <h3 class="h6 fw-bold text-dark mb-1">Account Found</h3>
                <p class="text-muted small mb-0">
                    We found an account registered under <strong><%= email %></strong>. If this is your account, please log in below.
                </p>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a href="/login" class="btn btn-quizo-primary">
            <i class="fa-solid fa-right-to-bracket me-1"></i> Proceed to Login
        </a>
        <a href="/signup" class="btn btn-quizo-secondary">
            <i class="fa-solid fa-user-plus me-1"></i> Use Another Email
        </a>
    </div>
</div>

<%- include("../partials/footer") %>

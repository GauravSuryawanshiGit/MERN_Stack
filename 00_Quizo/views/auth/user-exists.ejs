<%- include("../partials/header") %>

<div class="container-fluid">

    <section class="utility-page">

        <div class="utility-card">

            <div class="utility-icon warning">

                <i class="fa-solid fa-user-check"></i>

            </div>

            <p class="utility-eyebrow">
                Account already exists
            </p>

            <h1>
                That email is already registered
            </h1>

            <p class="utility-copy">
                We found an existing Quizo account for
                <strong><%= email %></strong>.
                You can log in right away or go back and use a different email address.
            </p>

            <div class="utility-actions">

                <a href="/login" class="btn btn-success btn-lg">
                    Go to Login
                </a>

                <a href="/signup" class="btn btn-outline-success btn-lg">
                    Use Another Email
                </a>

            </div>

        </div>

    </section>

</div>

<%- include("../partials/footer") %>

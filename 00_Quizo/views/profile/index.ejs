<%- include("../partials/header") %>

<% 
    const profileUser = typeof userDoc !== "undefined" && userDoc ? userDoc : (typeof user !== "undefined" && user ? user : {}); 
    const safeLevel = typeof level !== "undefined" ? level : 1; 
    const safeRank = typeof rank !== "undefined" ? rank : 1; 
    const safeAccuracy = typeof accuracy !== "undefined" ? accuracy : 0; 
    const safeAchievementCount = typeof achievementCount !== "undefined" ? achievementCount : 0; 
    const safeRecentAttempts = typeof recentAttempts !== "undefined" && Array.isArray(recentAttempts) ? recentAttempts : []; 
    const safeXpPercent = typeof xpPercent !== "undefined" ? xpPercent : Math.min(((Number(profileUser.xp) || 0) / 1500) * 100, 100); 
%>

<!-- Page Header (Large, Left-Aligned) -->
<div class="panel-header d-flex justify-content-between align-items-start flex-wrap gap-3">
    <div>
        <h1 class="panel-title">User Profile</h1>
        <p class="panel-subtitle">
            Account identity, learning achievements, and performance history on Quizo.
        </p>
    </div>
    <div>
        <a href="/profile/edit" class="btn btn-quizo-primary">
            <i class="fa-solid fa-pen-to-square me-1"></i> Edit Profile
        </a>
    </div>
</div>

<!-- Profile Info Panel (Clean, Subtle Bordered Block) -->
<div class="stat-box mb-4">
    <div class="row align-items-center g-4">
        <!-- Avatar -->
        <div class="col-auto">
            <div style="width: 88px; height: 88px; border-radius: 4px; background: var(--primary-light); color: #FFFFFF; font-size: 2.25rem; font-weight: 700; display: flex; align-items: center; justify-content: center; overflow: hidden; border: 2px solid var(--border-subtle);">
                <% if (profileUser.avatar && profileUser.avatar.startsWith("data:image/")) { %>
                    <img src="<%= profileUser.avatar %>" alt="<%= profileUser.name %>" style="width: 100%; height: 100%; object-fit: cover;">
                <% } else { %>
                    <%= (profileUser.name || "U").charAt(0).toUpperCase() %>
                <% } %>
            </div>
        </div>

        <!-- Details -->
        <div class="col">
            <div class="d-flex align-items-center gap-2 mb-1">
                <h2 class="h4 fw-bold text-dark mb-0"><%= profileUser.name %></h2>
                <span class="badge bg-secondary text-uppercase"><%= profileUser.role || "user" %></span>
            </div>

            <p class="text-muted small mb-2">
                <i class="fa-solid fa-envelope me-1"></i> <%= profileUser.email %>
                &bull; <i class="fa-regular fa-calendar ms-2 me-1"></i> Member Since: <strong><%= profileUser.createdAt ? new Date(profileUser.createdAt).toLocaleDateString() : "2026" %></strong>
            </p>

            <% if (profileUser.bio && profileUser.bio.trim() !== "") { %>
                <div class="p-2 px-3 bg-white border rounded small text-secondary mt-1">
                    <i class="fa-solid fa-quote-left me-1 text-muted"></i>
                    <%= profileUser.bio %>
                </div>
            <% } %>
        </div>
    </div>
</div>

<!-- Experience & Level Progress -->
<div class="progress-section mb-4">
    <div class="d-flex justify-content-between align-items-center mb-1">
        <h3 class="h6 fw-bold text-dark mb-0">Experience Progress</h3>
        <span class="small fw-semibold text-muted">Level <%= safeLevel %> &bull; <%= profileUser.xp || 0 %> XP</span>
    </div>
    <div class="progress-track">
        <div class="progress-fill" style="width: <%= safeXpPercent %>%;"></div>
    </div>
    <div class="text-muted small">
        Keep taking quizzes to earn XP and level up your status.
    </div>
</div>

<!-- Statistics Grid -->
<h2 class="section-title">Performance Overview</h2>
<p class="section-subtitle">Aggregate metrics compiled across all assessment attempts.</p>

<div class="stats-grid mb-4">
    <div class="stat-box">
        <div class="stat-box-label">Total Experience</div>
        <div class="stat-box-value text-success"><%= profileUser.xp || 0 %> XP</div>
        <div class="stat-box-desc">All earned experience points</div>
    </div>

    <div class="stat-box">
        <div class="stat-box-label">Current Level</div>
        <div class="stat-box-value">Level <%= safeLevel %></div>
        <div class="stat-box-desc">Progression ranking tier</div>
    </div>

    <div class="stat-box">
        <div class="stat-box-label">Global Standing</div>
        <div class="stat-box-value">#<%= safeRank %></div>
        <div class="stat-box-desc">Rank on the global leaderboard</div>
    </div>

    <div class="stat-box">
        <div class="stat-box-label">Average Accuracy</div>
        <div class="stat-box-value <%= safeAccuracy >= 70 ? 'text-success' : 'text-dark' %>"><%= safeAccuracy %>%</div>
        <div class="stat-box-desc">Evaluation accuracy rate</div>
    </div>

    <div class="stat-box">
        <div class="stat-box-label">Total Quizzes</div>
        <div class="stat-box-value"><%= profileUser.totalQuizzes || 0 %></div>
        <div class="stat-box-desc">Finished quiz assessments</div>
    </div>

    <div class="stat-box">
        <div class="stat-box-label">Badges Unlocked</div>
        <div class="stat-box-value"><%= safeAchievementCount %></div>
        <div class="stat-box-desc">Milestone badges earned</div>
    </div>
</div>

<!-- Recent Attempts Table -->
<h2 class="section-title">Recent Activity</h2>
<p class="section-subtitle">Your most recently completed quizzes and recorded scores.</p>

<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>Subject</th>
                <th>Difficulty</th>
                <th>Score</th>
                <th>Accuracy</th>
                <th>Time</th>
                <th>XP</th>
            </tr>
        </thead>
        <tbody>
            <% if (safeRecentAttempts.length > 0) { %>
                <% safeRecentAttempts.forEach(a => { %>
                    <tr>
                        <td><strong><%= a.subject %></strong></td>
                        <td><span class="badge bg-secondary"><%= a.difficulty %></span></td>
                        <td><%= a.correct %> / <%= a.total %></td>
                        <td><%= a.accuracy %>%</td>
                        <td><%= Math.floor((a.quizTime || 0) / 60) %>m <%= (a.quizTime || 0) % 60 %>s</td>
                        <td><span class="text-success fw-semibold">+<%= a.xp %> XP</span></td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">
                        No recent quiz activity found.
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>

<%- include("../partials/footer") %>

<div id="chatToggle">

    <i class="fas fa-robot"></i>

</div>

<div id="chatWindow">

    <div id="chatHeader">

        <div>

            <strong>
                Quizo AI
            </strong>

            <small>
                Powered by Gemini
            </small>

        </div>

        <button id="closeChat">

            <i class="fas fa-times"></i>

        </button>

    </div>

    <div id="messages"></div>

    <div id="chatInput">

        <input id="userMessage" type="text" placeholder="Ask anything...">

        <button onclick="sendMessage()">

            <i class="fas fa-paper-plane"></i>

        </button>

    </div>

</div>
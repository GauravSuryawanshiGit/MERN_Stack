<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Quizo | Skill Assessment Platform</title>

    <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png">
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
    <link rel="manifest" href="/images/site.webmanifest">

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <!-- Quizo Modern Minimal Theme -->
    <link href="/css/style.css" rel="stylesheet">

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body>

    <!-- Full-Width Solid Navigation Bar -->
    <header class="quizo-topbar">
        <div class="quizo-nav-container">
            <!-- Branding & Short Subtitle on Left -->
            <a href="/" class="quizo-brand" title="Quizo Home">
                <div class="quizo-logo-icon">
                    <i class="fa-solid fa-graduation-cap"></i>
                </div>
                <div class="quizo-brand-text">
                    <span class="quizo-brand-name">Quizo</span>
                    <span class="quizo-brand-tagline">Skill Assessment Platform</span>
                </div>
            </a>

            <!-- Mobile Menu Toggle Button -->
            <button class="quizo-mobile-toggle d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#quizoNavbarCollapse" aria-controls="quizoNavbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
                <i class="fa-solid fa-bars"></i>
            </button>

            <!-- Navigation Links and Actions Aligned Right -->
            <div class="collapse d-lg-flex quizo-nav-collapse" id="quizoNavbarCollapse">
                <nav class="quizo-nav-menu" aria-label="Main Navigation">
                    <a href="/" class="quizo-nav-item">Home</a>
                    <a href="/dashboard" class="quizo-nav-item">Dashboard</a>
                    <a href="/leaderboard" class="quizo-nav-item">Leaderboard</a>
                    <a href="/achievements" class="quizo-nav-item">Achievements</a>
                    <% if (user) { %>
                        <a href="/profile" class="quizo-nav-item">Profile</a>
                        <% if (user.role === "admin") { %>
                            <a href="/admin" class="quizo-nav-item quizo-admin-link">Admin</a>
                        <% } %>
                    <% } %>
                </nav>

                <div class="quizo-nav-actions">
                    <% if (user) { %>
                        <a href="/profile" class="quizo-user-badge" title="View Profile">
                            <div class="quizo-user-avatar">
                                <% if (user.avatar && user.avatar.startsWith("data:image/")) { %>
                                    <img src="<%= user.avatar %>" alt="<%= user.name %>">
                                <% } else { %>
                                    <%= user.name.charAt(0).toUpperCase() %>
                                <% } %>
                            </div>
                            <span class="quizo-user-name"><%= user.name %></span>
                        </a>

                        <a href="/logout" class="quizo-btn quizo-btn-nav-logout" data-confirm="true"
                            data-confirm-title="Log out?"
                            data-confirm-text="You will need to log in again to continue learning."
                            data-confirm-icon="question">
                            <i class="fa-solid fa-arrow-right-from-bracket me-1"></i> Logout
                        </a>
                    <% } else { %>
                        <a href="/login" class="quizo-btn quizo-btn-nav-outline">
                            Login
                        </a>
                        <a href="/signup" class="quizo-btn quizo-btn-nav-primary">
                            Create Account
                        </a>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Thin Accent-Color Border Below Navigation -->
        <div class="quizo-nav-accent-bar"></div>
    </header>

    <!-- Main Content Panel (Large White Panel with Subtle Borders & Generous Spacing) -->
    <main class="quizo-main">
        <div class="quizo-panel">

<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>Quizo | Skill Assessment</title>

<link rel="icon" type="image/x-icon" href="/images/favicon.ico">

<link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">

<link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png">

<link rel="apple-touch-icon" href="/images/apple-touch-icon.png">

<link rel="manifest" href="/images/site.webmanifest">

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<link rel="stylesheet"
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

<link href="/css/style.css" rel="stylesheet">

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<!-- <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script> -->

</head>

<body>

<!-- ===========================
        MOBILE NAVBAR
============================ -->

<nav class="mobile-navbar d-lg-none">

    <button
    class="menu-btn"
    type="button"
    data-bs-toggle="offcanvas"
    data-bs-target="#mobileSidebar">

        <i class="bi bi-list"></i>

    </button>

    <div class="mobile-logo">

        <i class="bi bi-mortarboard-fill"></i>

        <span>Quizo</span>

    </div>

    <% if(user){ %>

    <div class="avatar">

        <%= user.name.charAt(0).toUpperCase() %>

    </div>

    <% } %>

</nav>

<!-- ===========================
          DESKTOP SIDEBAR
============================ -->

<aside class="sidebar d-none d-lg-flex">

    <!-- Logo -->

    <div class="logo">

        <i class="bi bi-mortarboard-fill"></i>

        <div>

            <h3 class="mb-0 fw-bold">

                Quizo

            </h3>

          

        </div>

    </div>

    <!-- Navigation -->

    <ul class="sidebar-menu">

        <li>

            <a href="/">

                <i class="bi bi-house-door"></i>

                <span>Home</span>

            </a>

        </li>

        <li>

            <a href="/dashboard">

                <i class="bi bi-speedometer2"></i>

                <span>Dashboard</span>

            </a>

        </li>

        <li>

            <a href="/leaderboard">

                <i class="bi bi-trophy"></i>

                <span>Leaderboard</span>

            </a>

        </li>

        <li>

            <a href="/achievements">

                <i class="bi bi-award"></i>

                <span>Achievements</span>

            </a>

        </li>

        <li>

            <a href="/profile">

                <i class="bi bi-person-circle"></i>

                <span>Profile</span>

            </a>

        </li>

        <!-- <li>

            <a href="/settings">

                <i class="bi bi-gear"></i>

                <span>Settings</span>

            </a>

        </li> -->

        <% if(user && user.role==="admin"){ %>

        <li>

            <a href="/admin">

                <i class="bi bi-shield-lock"></i>

                <span>Admin Panel</span>

            </a>

        </li>

        <% } %>

    </ul>

    <!-- Bottom User Card -->

    <% if(user){ %>

    <div class="sidebar-bottom">

        <div class="sidebar-user">

            <div class="avatar">

                <%= user.name.charAt(0).toUpperCase() %>

            </div>

            <div>

                <div class="fw-semibold">

                    <%= user.name %>

                </div>

                <small class="text-white-50">

                    <%= user.role %>

                </small>

            </div>

        </div>

        <a
            href="/logout"
            class="logout-btn mt-3"
            data-confirm="true"
            data-confirm-title="Log out?"
            data-confirm-text="You will need to log in again to continue learning."
            data-confirm-icon="question">

            <i class="bi bi-box-arrow-right"></i>

            Logout

        </a>

    </div>

    <% } %>

</aside>
<!-- ===========================
        MOBILE SIDEBAR
============================ -->

<div
class="offcanvas offcanvas-start"
tabindex="-1"
id="mobileSidebar">

    <div class="offcanvas-header">

        <h5 class="offcanvas-title">

            <i class="bi bi-mortarboard-fill"></i>

            Quizo

        </h5>

        <button
        type="button"
        class="btn-close btn-close-white"
        data-bs-dismiss="offcanvas">
        </button>

    </div>

    <div class="offcanvas-body">

        <% if(user){ %>

        <div class="sidebar-user mb-4">

            <div class="avatar">

                <%= user.name.charAt(0).toUpperCase() %>

            </div>

            <div>

                <div class="fw-semibold">

                    <%= user.name %>

                </div>

                <small class="text-muted">

                    <%= user.role %>

                </small>

            </div>

        </div>

        <% } %>

        <ul class="list-unstyled mobile-menu">

            <li>

                <a href="/">

                    <i class="bi bi-house-door"></i>

                    Home

                </a>

            </li>

            <li>

                <a href="/dashboard">

                    <i class="bi bi-speedometer2"></i>

                    Dashboard

                </a>

            </li>

            <li>

                <a href="/leaderboard">

                    <i class="bi bi-trophy"></i>

                    Leaderboard

                </a>

            </li>

            <li>

                <a href="/achievements">

                    <i class="bi bi-award"></i>

                    Achievements

                </a>

            </li>

            <li>

                <a href="/profile">

                    <i class="bi bi-person-circle"></i>

                    Profile

                </a>

            </li>

            <% if(user && user.role==="admin"){ %>

            <li>

                <a href="/admin">

                    <i class="bi bi-shield-lock"></i>

                    Admin Panel

                </a>

            </li>

            <% } %>

        </ul>

        <% if(user){ %>

        <a
        href="/logout"
        class="logout-btn-mobile mt-4"
        data-confirm="true"
        data-confirm-title="Log out?"
        data-confirm-text="You will need to log in again to continue learning."
        data-confirm-icon="question">

            <i class="bi bi-box-arrow-right"></i>

            Logout

        </a>

        <% } else { %>

        <div class="d-grid gap-2 mt-4">

            <a href="/login" class="btn btn-outline-success">
                Login
            </a>

            <a href="/signup" class="btn btn-success">
                Create Account
            </a>

        </div>

        <% } %>

    </div>

</div>
<!-- ===========================
            MAIN CONTENT
=========================== -->

<div class="main-content">

    <!-- ===========================
            TOP NAVBAR
    =========================== -->

    <header class="topbar">

        <!-- Left -->

     <div class="ai-orbit">

    <div class="center-logo">

        <i class="fa-solid fa-brain"></i>

    </div>

    <span class="dot dot1"></span>

    <span class="dot dot2"></span>

    <span class="dot dot3"></span>

    <span class="dot dot4"></span>

</div>

        

        <!-- Right -->

        <div class="topbar-right">

            <!-- <button
            class="notification-btn"
            title="Notifications">

                <i class="bi bi-bell"></i>

            </button> -->

            <% if(user){ %>

            <div class="dropdown">

                <button
                class="user-card border-0 bg-transparent"
                data-bs-toggle="dropdown">

                    <div class="avatar">

                        <%= user.name.charAt(0).toUpperCase() %>

                    </div>

                    <div class="text-start">

                        <div class="user-name">

                            <%= user.name %>

                        </div>

                        <div class="user-role">

                            <%= user.role %>

                        </div>

                    </div>

                    <i class="bi bi-chevron-down ms-2"></i>

                </button>

                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4">

                    <li>

                        <a class="dropdown-item py-2" href="/profile">

                            <i class="bi bi-person-circle me-2"></i>

                            Profile

                        </a>

                    </li>

                    <li>

                        <!-- <a class="dropdown-item py-2" href="/settings">

                            <i class="bi bi-gear me-2"></i>

                            Settings

                        </a> -->

                    </li>

                    <li>

                        <hr class="dropdown-divider">

                    </li>

                    <li>

                        <a
                            class="dropdown-item py-2 text-danger"
                            href="/logout"
                            data-confirm="true"
                            data-confirm-title="Log out?"
                            data-confirm-text="You will need to log in again to continue learning."
                            data-confirm-icon="question">

                            <i class="bi bi-box-arrow-right me-2"></i>

                            Logout

                        </a>

                    </li>

                </ul>

            </div>

            <% } else { %>

            <div class="d-flex align-items-center gap-2">

                <a href="/login" class="btn btn-outline-success">
                    Login
                </a>

                <a href="/signup" class="btn btn-success">
                    Sign Up
                </a>

            </div>

            <% } %>

        </div>

    </header>

    <!-- ===========================
            PAGE CONTENT
    =========================== -->

    <div class="page-content">

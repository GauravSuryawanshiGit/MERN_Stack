<%- include("../partials/header") %>

<!-- Page Header (Large, Left-Aligned) -->
<div class="panel-header d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
        <h1 class="panel-title"><%= category || subject %> Assessment</h1>
        <p class="panel-subtitle">
            Difficulty: <strong><%= difficulty ? difficulty.charAt(0).toUpperCase() + difficulty.slice(1) : "Easy" %></strong>
            &bull; Question count: <strong><%= questions.length %></strong>
            &bull; All questions must be submitted before the timer expires.
        </p>
    </div>
    <!-- Timer & Controls -->
    <div class="d-flex align-items-center gap-2">
        <div class="quiz-timer-box">
            <span class="text-muted small fw-semibold"><i class="fa-regular fa-clock me-1"></i> Time Remaining:</span>
            <span id="quizTimerDisplay" class="timer-indicator">10:00</span>
        </div>
    </div>
</div>

<!-- Question Navigation Palette & Stats Bar -->
<div class="stat-box mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
        <span class="small fw-bold text-dark text-uppercase">Question Palette</span>
        <div class="d-flex gap-3 small">
            <span><i class="fa-solid fa-circle text-success me-1"></i> Answered: <strong id="answeredCount">0</strong></span>
            <span><i class="fa-solid fa-circle text-secondary me-1"></i> Unanswered: <strong id="unansweredCount"><%= questions.length %></strong></span>
            <span><i class="fa-solid fa-flag text-warning me-1"></i> Flagged: <strong id="flaggedCount">0</strong></span>
        </div>
    </div>

    <!-- Clickable Question Number Pills -->
    <div class="d-flex flex-wrap gap-2" id="questionPalette">
        <% questions.forEach((q, index) => { %>
            <button type="button" class="btn btn-sm btn-outline-secondary palette-btn <%= index === 0 ? 'active' : '' %>"
                data-index="<%= index %>" style="width: 38px; height: 38px; font-weight: 600;">
                <%= index + 1 %>
            </button>
        <% }) %>
    </div>
</div>

<!-- Main Quiz Form -->
<form id="quizForm" action="/quiz/submit" method="POST">
    <input type="hidden" name="attemptId" value="<%= attemptId %>">
    <input type="hidden" id="quizTime" name="quizTime" value="0">
    <input type="hidden" name="category" value="<%= category || subject %>">
    <input type="hidden" name="subject" value="<%= subject || category %>">
    <input type="hidden" name="difficulty" value="<%= difficulty %>">
    <% if (typeof isDailyChallenge !== "undefined" && isDailyChallenge) { %>
        <input type="hidden" name="isDailyChallenge" value="true">
    <% } %>

    <!-- Question Cards (Step Navigation) -->
    <div id="questionsContainer">
        <% questions.forEach((q, index) => { %>
            <div class="quiz-step-card" id="questionCard-<%= index %>" style="<%= index === 0 ? 'display: block;' : 'display: none;' %>">
                <div class="quiz-question-box">
                    <div class="question-meta">
                        <span class="question-number">Question <%= index + 1 %> of <%= questions.length %></span>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-outline-warning flag-btn" data-index="<%= index %>">
                                <i class="fa-regular fa-flag me-1"></i> Mark for Review
                            </button>
                            <span class="badge bg-secondary">#<%= index + 1 %></span>
                        </div>
                    </div>

                    <div class="question-text">
                        <%= q.question %>
                    </div>

                    <div class="options-list">
                        <% q.options.forEach((option, optIdx) => { %>
                            <label class="option-card" for="opt-<%= q._id %>-<%= optIdx %>">
                                <input type="radio" id="opt-<%= q._id %>-<%= optIdx %>" name="<%= q._id %>" value="<%= option %>" class="quiz-option-radio" data-qindex="<%= index %>">
                                <span><%= option %></span>
                            </label>
                        <% }) %>
                    </div>

                    <div class="mt-3 pt-2 border-top d-flex justify-content-between align-items-center">
                        <button type="button" class="btn btn-sm btn-outline-danger clear-btn" data-index="<%= index %>" data-qid="<%= q._id %>">
                            <i class="fa-solid fa-eraser me-1"></i> Clear Selection
                        </button>
                        <span class="small text-muted">Select one option to record your answer</span>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>

    <!-- Navigation & Submit Bar -->
    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top flex-wrap gap-2">
        <div class="d-flex gap-2">
            <button type="button" id="prevBtn" class="btn btn-quizo-secondary" disabled>
                <i class="fa-solid fa-arrow-left me-1"></i> Previous
            </button>
            <button type="button" id="nextBtn" class="btn btn-quizo-secondary">
                Next <i class="fa-solid fa-arrow-right ms-1"></i>
            </button>
        </div>

        <div class="d-flex gap-2">
            <a href="/" class="btn btn-quizo-secondary" data-confirm="true"
                data-confirm-title="Leave Quiz?"
                data-confirm-text="Your quiz progress will be abandoned."
                data-confirm-icon="warning">
                Cancel
            </a>
            <button type="button" id="submitModalBtn" class="btn btn-quizo-primary btn-lg">
                <i class="fa-solid fa-check me-1"></i> Submit Assessment
            </button>
        </div>
    </div>
</form>

<%- include("../partials/footer") %>

<script>
    const totalQuestions = <%= questions.length %>;
    const allocatedSeconds = <%= durationSeconds || (questions.length * 60) %>;
    let currentQuestionIndex = 0;
    let remainingSeconds = allocatedSeconds;
    let elapsedSeconds = 0;
    let timerInterval = null;

    const flaggedQuestions = new Set();
    const answeredQuestions = new Set();

    // DOM Elements
    const timerDisplay = document.getElementById("quizTimerDisplay");
    const quizTimeInput = document.getElementById("quizTime");
    const prevBtn = document.getElementById("prevBtn");
    const nextBtn = document.getElementById("nextBtn");
    const submitBtn = document.getElementById("submitModalBtn");
    const quizForm = document.getElementById("quizForm");

    // Show specific question index
    function showQuestion(index) {
        if (index < 0 || index >= totalQuestions) return;

        // Hide all cards
        for (let i = 0; i < totalQuestions; i++) {
            const card = document.getElementById(`questionCard-${i}`);
            if (card) card.style.display = (i === index) ? "block" : "none";
        }

        currentQuestionIndex = index;

        // Update Prev / Next Buttons
        prevBtn.disabled = (index === 0);
        if (index === totalQuestions - 1) {
            nextBtn.textContent = "Finish Review";
        } else {
            nextBtn.innerHTML = 'Next <i class="fa-solid fa-arrow-right ms-1"></i>';
        }

        updatePaletteUI();
    }

    // Update Question Palette Visual States
    function updatePaletteUI() {
        for (let i = 0; i < totalQuestions; i++) {
            const pill = document.querySelector(`.palette-btn[data-index="${i}"]`);
            if (!pill) continue;

            pill.className = "btn btn-sm palette-btn";

            if (i === currentQuestionIndex) {
                pill.style.outline = "2px solid #0F766E";
                pill.style.outlineOffset = "2px";
            } else {
                pill.style.outline = "none";
            }

            if (flaggedQuestions.has(i)) {
                pill.classList.add("btn-warning", "text-dark");
            } else if (answeredQuestions.has(i)) {
                pill.classList.add("btn-success");
            } else {
                pill.classList.add("btn-outline-secondary");
            }
        }

        // Update counts
        document.getElementById("answeredCount").textContent = answeredQuestions.size;
        document.getElementById("unansweredCount").textContent = totalQuestions - answeredQuestions.size;
        document.getElementById("flaggedCount").textContent = flaggedQuestions.size;
    }

    // Radio change listener
    document.querySelectorAll(".quiz-option-radio").forEach(radio => {
        radio.addEventListener("change", function() {
            const qIdx = parseInt(this.dataset.qindex, 10);
            answeredQuestions.add(qIdx);
            updatePaletteUI();
        });
    });

    // Clear Selection
    document.querySelectorAll(".clear-btn").forEach(btn => {
        btn.addEventListener("click", function() {
            const idx = parseInt(this.dataset.index, 10);
            const qid = this.dataset.qid;
            document.querySelectorAll(`input[name="${qid}"]`).forEach(r => r.checked = false);
            answeredQuestions.delete(idx);
            updatePaletteUI();
        });
    });

    // Flag for review
    document.querySelectorAll(".flag-btn").forEach(btn => {
        btn.addEventListener("click", function() {
            const idx = parseInt(this.dataset.index, 10);
            if (flaggedQuestions.has(idx)) {
                flaggedQuestions.delete(idx);
                this.innerHTML = '<i class="fa-regular fa-flag me-1"></i> Mark for Review';
                this.className = "btn btn-sm btn-outline-warning flag-btn";
            } else {
                flaggedQuestions.add(idx);
                this.innerHTML = '<i class="fa-solid fa-flag text-warning me-1"></i> Flagged';
                this.className = "btn btn-sm btn-warning text-dark flag-btn";
            }
            updatePaletteUI();
        });
    });

    // Palette pill click
    document.querySelectorAll(".palette-btn").forEach(btn => {
        btn.addEventListener("click", function() {
            const idx = parseInt(this.dataset.index, 10);
            showQuestion(idx);
        });
    });

    // Previous / Next buttons
    prevBtn.addEventListener("click", () => {
        if (currentQuestionIndex > 0) showQuestion(currentQuestionIndex - 1);
    });

    nextBtn.addEventListener("click", () => {
        if (currentQuestionIndex < totalQuestions - 1) {
            showQuestion(currentQuestionIndex + 1);
        } else {
            // At last question, trigger submit dialog
            promptSubmit();
        }
    });

    // Timer Implementation with Auto-Submit
    function startTimer() {
        timerInterval = setInterval(() => {
            remainingSeconds--;
            elapsedSeconds++;

            quizTimeInput.value = elapsedSeconds;

            const mins = Math.floor(Math.max(0, remainingSeconds) / 60);
            const secs = Math.max(0, remainingSeconds) % 60;
            timerDisplay.textContent = `${String(mins).padStart(2, "0")}:${String(secs).padStart(2, "0")}`;

            if (remainingSeconds <= 60) {
                timerDisplay.classList.add("text-danger");
                timerDisplay.style.borderColor = "#DC2626";
            }

            if (remainingSeconds <= 0) {
                clearInterval(timerInterval);
                timerInterval = null;
                autoSubmitExpired();
            }
        }, 1000);
    }

    function autoSubmitExpired() {
        Swal.fire({
            title: "Time Has Expired!",
            text: "Your quiz time has finished. Your answers are being submitted automatically.",
            icon: "warning",
            allowOutsideClick: false,
            allowEscapeKey: false,
            showConfirmButton: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });

        setTimeout(() => {
            quizForm.submit();
        }, 800);
    }

    // Manual Submit with Unanswered Count Warning
    function promptSubmit() {
        const answered = answeredQuestions.size;
        const unanswered = totalQuestions - answered;

        let warningText = `You have answered ${answered} of ${totalQuestions} questions.`;
        if (unanswered > 0) {
            warningText += ` Notice: ${unanswered} question${unanswered === 1 ? ' is' : 's are'} still unanswered and will be marked as skipped.`;
        } else {
            warningText += " All questions have been answered.";
        }

        Swal.fire({
            title: "Submit Assessment?",
            text: warningText,
            icon: unanswered > 0 ? "warning" : "question",
            showCancelButton: true,
            confirmButtonColor: "#0F766E",
            cancelButtonColor: "#64748B",
            confirmButtonText: "Yes, Submit Now",
            cancelButtonText: "Return to Questions"
        }).then(result => {
            if (result.isConfirmed) {
                clearInterval(timerInterval);
                Swal.fire({
                    title: "Evaluating Your Assessment",
                    text: "Calculating score, recording accuracy, and updating your progress...",
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    showConfirmButton: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                setTimeout(() => {
                    quizForm.submit();
                }, 200);
            }
        });
    }

    submitBtn.addEventListener("click", promptSubmit);

    // Prevent accidental page leave / navigation loss
    window.addEventListener("beforeunload", function(e) {
        if (quizForm.dataset.submitting !== "true" && remainingSeconds > 0) {
            e.preventDefault();
            e.returnValue = "";
        }
    });

    quizForm.addEventListener("submit", function() {
        this.dataset.submitting = "true";
    });

    // Start timer & palette on load
    window.addEventListener("DOMContentLoaded", () => {
        startTimer();
        updatePaletteUI();
    });
</script>

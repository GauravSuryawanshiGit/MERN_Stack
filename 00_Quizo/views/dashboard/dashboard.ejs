<%- include("../partials/header") %>

<!-- Page Header (Large, Left-Aligned) -->
<div class="panel-header">
    <h1 class="panel-title">Learner Dashboard</h1>
    <p class="panel-subtitle">
        Welcome back, <strong><%= user.name %></strong>. Review your performance analytics, active streak, and recent quiz attempts.
    </p>
</div>

<!-- Key Performance Metrics (Clean, Subtle Bordered Grid) -->
<div class="stats-grid mb-4">
    <div class="stat-box">
        <div class="stat-box-label">Total Experience</div>
        <div class="stat-box-value text-success"><%= user.xp || 0 %> XP</div>
        <div class="stat-box-desc">Earned from completed quizzes</div>
    </div>

    <div class="stat-box">
        <div class="stat-box-label">Current Level</div>
        <div class="stat-box-value">Level <%= level %></div>
        <div class="stat-box-desc">Overall skill rank classification</div>
    </div>

    <div class="stat-box">
        <div class="stat-box-label">Global Rank</div>
        <div class="stat-box-value">#<%= rank %></div>
        <div class="stat-box-desc">Position on the global leaderboard</div>
    </div>

    <div class="stat-box">
        <div class="stat-box-label">Best Quiz Time</div>
        <div class="stat-box-value">
            <%= bestTime !== null ? Math.floor(bestTime / 60) + "m " + (bestTime % 60) + "s" : "--" %>
        </div>
        <div class="stat-box-desc">Fastest quiz completion recorded</div>
    </div>

    <div class="stat-box">
        <div class="stat-box-label">Active Streak</div>
        <div class="stat-box-value text-warning">
            <i class="fa-solid fa-fire me-1"></i><%= user.streak || 0 %> Days
        </div>
        <div class="stat-box-desc">Consistent practice frequency</div>
    </div>
</div>

<!-- Vertically Stacked Section 1: Level Progress -->
<div class="progress-section mb-4">
    <div class="d-flex justify-content-between align-items-center mb-1">
        <h3 class="h6 fw-bold text-dark mb-0">Level Progress</h3>
        <span class="small fw-semibold text-muted">Level <%= level %> &bull; <%= xpProgress %>%</span>
    </div>
    <div class="progress-track">
        <div class="progress-fill" style="width: <%= xpProgress %>%;"></div>
    </div>
    <div class="d-flex justify-content-between text-muted small mt-1">
        <span>Current XP: <strong><%= user.xp %></strong></span>
        <span>Keep answering to reach Level <%= level + 1 %></span>
    </div>
</div>

<!-- Vertically Stacked Section 2: Daily Challenge & Achievements -->
<div class="row g-3 mb-4">
    <!-- Daily Challenge -->
    <% if (typeof dailyChallenge !== "undefined" && dailyChallenge) { %>
        <div class="col-lg-6">
            <div class="daily-challenge-panel h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h3 class="h6 fw-bold text-dark mb-0">
                            <i class="fa-solid fa-calendar-check text-success me-1"></i> Daily Challenge
                        </h3>
                        <span class="badge bg-warning">+<%= dailyChallenge.rewardXP %> XP Bonus</span>
                    </div>
                    <p class="text-muted small mb-2">
                        Complete today's featured challenge to earn bonus XP and maintain your daily streak.
                    </p>
                    <div class="small mb-3">
                        <span class="me-3">Subject: <strong><%= dailyChallenge.subject %></strong></span>
                        <span>Difficulty: <strong><%= dailyChallenge.difficulty %></strong></span>
                    </div>
                </div>
                <div>
                    <a href="/challenge" class="btn btn-quizo-primary btn-sm">
                        <i class="fa-solid fa-play me-1"></i> Start Daily Challenge
                    </a>
                </div>
            </div>
        </div>
    <% } %>

    <!-- Unlocked Achievements -->
    <div class="<%= typeof dailyChallenge !== 'undefined' && dailyChallenge ? 'col-lg-6' : 'col-12' %>">
        <div class="stat-box h-100 d-flex flex-column justify-content-between">
            <div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h3 class="h6 fw-bold text-dark mb-0">
                        <i class="fa-solid fa-award text-primary me-1"></i> Earned Badges
                    </h3>
                    <a href="/achievements" class="small text-decoration-none">View All</a>
                </div>
                <div class="d-flex flex-wrap gap-2 mt-2">
                    <span class="badge bg-success p-2">First Quiz</span>
                    <% if (user.totalQuizzes >= 10) { %>
                        <span class="badge bg-success p-2">10 Quizzes</span>
                    <% } %>
                    <% if (user.xp >= 100) { %>
                        <span class="badge bg-info p-2">Level Up</span>
                    <% } %>
                    <% if (accuracy === 100) { %>
                        <span class="badge bg-danger p-2">Perfect Accuracy</span>
                    <% } %>
                </div>
            </div>
            <div class="mt-3">
                <span class="text-muted small">Total Assessments Completed: <strong><%= user.totalQuizzes || 0 %></strong></span>
            </div>
        </div>
    </div>
</div>

<!-- Vertically Stacked Section 3: Performance Summary Grid -->
<h2 class="section-title">Assessment Summary</h2>
<p class="section-subtitle">Aggregate statistics calculated across all completed quiz sessions.</p>

<div class="stats-grid mb-4">
    <div class="stat-box">
        <div class="stat-box-label">Quizzes Finished</div>
        <div class="stat-box-value"><%= user.totalQuizzes || 0 %></div>
    </div>
    <div class="stat-box">
        <div class="stat-box-label">Questions Attempted</div>
        <div class="stat-box-value"><%= user.totalQuestions || 0 %></div>
    </div>
    <div class="stat-box">
        <div class="stat-box-label">Correct Answers</div>
        <div class="stat-box-value text-success"><%= user.totalCorrect || 0 %></div>
    </div>
    <div class="stat-box">
        <div class="stat-box-label">Average Accuracy</div>
        <div class="stat-box-value <%= accuracy >= 70 ? 'text-success' : 'text-dark' %>"><%= accuracy %>%</div>
    </div>
</div>

<!-- Vertically Stacked Section 4: Subject Performance Chart -->
<div class="stat-box mb-4">
    <h3 class="h6 fw-bold text-dark mb-3">
        <i class="fa-solid fa-chart-column me-2 text-primary"></i>Subject Performance Analysis
    </h3>
    <div style="height: 280px; position: relative;">
        <canvas id="subjectChart"></canvas>
    </div>
</div>

<!-- Vertically Stacked Section 5: Recent Quiz Attempts Table -->
<h2 class="section-title">Recent Quiz Attempts</h2>
<p class="section-subtitle">Detailed record of your latest assessment submissions and scores.</p>

<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>Subject</th>
                <th>Difficulty</th>
                <th>Score</th>
                <th>Accuracy</th>
                <th>Duration</th>
                <th>XP Awarded</th>
            </tr>
        </thead>
        <tbody>
            <% if (attempts && attempts.length > 0) { %>
                <% attempts.forEach(a => { %>
                    <tr>
                        <td><strong><%= a.subject %></strong></td>
                        <td>
                            <span class="badge bg-secondary"><%= a.difficulty %></span>
                        </td>
                        <td><%= a.correct %> / <%= a.total %></td>
                        <td>
                            <span class="<%= a.accuracy >= 70 ? 'text-success fw-semibold' : '' %>">
                                <%= a.accuracy %>%
                            </span>
                        </td>
                        <td>
                            <%= Math.floor((a.quizTime || 0) / 60) %>m <%= (a.quizTime || 0) % 60 %>s
                        </td>
                        <td><span class="text-success fw-semibold">+<%= a.xp %> XP</span></td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">
                        No quiz attempts recorded yet. <a href="/">Take your first quiz now</a>.
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>

<%- include("../partials/footer") %>
